# ── Model provider ────────────────────────────────────────────────────────────
# Options: anthropic | ollama | openrouter  (default: anthropic)
MODEL_PROVIDER=anthropic

# Model name — defaults per provider:
#   anthropic  → claude-sonnet-4-6
#   ollama     → llama3.2
#   openrouter → mistralai/mistral-7b-instruct
MODEL_NAME=claude-sonnet-4-6

# ── Provider credentials ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenRouter (only needed when MODEL_PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-your-key-here

# Ollama base URL (only needed when MODEL_PROVIDER=ollama; default shown)
OLLAMA_BASE_URL=http://localhost:11434

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./research_agent.db
