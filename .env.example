# ── Model provider ────────────────────────────────────────────────────────────
# Choose one. Default: anthropic
# Options: anthropic | openai | google | xai | mistral | groq | deepseek |
#          together | perplexity | cohere | openrouter | ollama | custom
MODEL_PROVIDER=anthropic

# Model name — overrides the provider default shown below.
# Leave unset to use the provider's default.
MODEL_NAME=

# ── Provider credentials ───────────────────────────────────────────────────────
# Only the key for your chosen MODEL_PROVIDER is required.

# Anthropic — default: claude-sonnet-4-6 (supports prompt caching)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — default: gpt-4o
OPENAI_API_KEY=sk-...

# Google Gemini — default: gemini-2.0-flash
GOOGLE_API_KEY=AIza...

# xAI (Grok) — default: grok-3
XAI_API_KEY=xai-...

# Mistral — default: mistral-large-latest
MISTRAL_API_KEY=...

# Groq (fast inference: Llama, Mixtral, Gemma) — default: llama-3.3-70b-versatile
GROQ_API_KEY=gsk_...

# DeepSeek — default: deepseek-chat
DEEPSEEK_API_KEY=sk-...

# Together AI (200+ open models) — default: meta-llama/Llama-3.3-70b-instruct-turbo
TOGETHER_API_KEY=...

# Perplexity — default: sonar-pro
PERPLEXITY_API_KEY=pplx-...

# Cohere — default: command-r-plus
COHERE_API_KEY=...

# OpenRouter (300+ models via one key) — default: mistralai/mistral-7b-instruct
# Example MODEL_NAME values: openai/gpt-4o, google/gemini-2.0-flash, meta-llama/llama-3.3-70b
OPENROUTER_API_KEY=sk-or-...

# Ollama (local models) — default model: llama3.2
# OLLAMA_BASE_URL defaults to http://localhost:11434 if unset
OLLAMA_BASE_URL=http://localhost:11434

# Custom OpenAI-compatible endpoint (any provider not listed above)
# MODEL_NAME is required when using custom
CUSTOM_BASE_URL=https://your-endpoint.example.com/v1
CUSTOM_API_KEY=your-key-here

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./research_agent.db
